---
import Base from '../layouts/Base.astro';
---

<Base
  title="Portfolio — CK Soluciones | Catálogo de Desarrollos"
  description="Catálogo de proyectos desarrollados por CK Soluciones: agentes AI, software a medida, e-commerce y sitios web institucionales."
  canonical="https://cksoluciones.com/portfolio"
  ogTitle="Portfolio — CK Soluciones | Catálogo de Desarrollos"
  ogDescription="Proyectos reales: agentes de IA, automatizaciones, software a medida y despliegues cloud. Cada uno resolvió un problema concreto."
  page="portfolio"
>

<!-- ══════════════════════════ HERO ══════════════════════════ -->
<section class="relative pt-16 overflow-hidden grid-bg">
  <div class="blob blob-purple" aria-hidden="true"></div>
  <div class="blob blob-blue"   aria-hidden="true"></div>
  <div class="blob blob-cyan"   aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 relative z-10">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm mb-10" style="color:#707777">
      <a href="/" class="transition-colors hover:text-white" style="color:#bbc7c6">CK Soluciones</a>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      <span style="color:#edfffe">Portfolio</span>
    </div>

    <div class="max-w-3xl">
      <p class="section-label mb-4">Catálogo de Desarrollos</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        Lo que hemos<br><span class="gradient-text">construido</span>
      </h1>
      <p class="text-lg leading-relaxed max-w-2xl" style="color:#bbc7c6">
        Proyectos reales: agentes de inteligencia artificial, software a medida y sitios web
        con instrumentación completa. Cada uno resolvió un problema concreto.
      </p>
    </div>

    <!-- Stats rápidos -->
    <div class="flex flex-wrap gap-10 mt-14 pb-16" style="border-bottom:1px solid rgba(0,130,124,0.15)">
      <div>
        <div class="text-2xl stat-glow">7</div>
        <div class="text-sm mt-1" style="color:#bbc7c6">Proyectos</div>
      </div>
      <div class="w-px self-stretch hidden sm:block" style="background:rgba(0,130,124,0.2)"></div>
      <div>
        <div class="text-2xl stat-glow">1</div>
        <div class="text-sm mt-1" style="color:#bbc7c6">AI &amp; Agentes</div>
      </div>
      <div class="w-px self-stretch hidden sm:block" style="background:rgba(0,130,124,0.2)"></div>
      <div>
        <div class="text-2xl" style="color:#edfffe">6</div>
        <div class="text-sm mt-1" style="color:#bbc7c6">Software a medida</div>
      </div>
    </div>
  </div>
</section>


<!-- ══════════════════════════ CATÁLOGO ══════════════════════════ -->
<section class="py-16" aria-labelledby="catalogo-h2">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <h2 id="catalogo-h2" class="sr-only">Catálogo de proyectos</h2>

    <!-- Filtros -->
    <div class="flex flex-wrap gap-3 mb-12" role="group" aria-label="Filtrar por categoría">
      <button class="filter-btn active" onclick="filterProjects('all', this)">Todos</button>
      <button class="filter-btn" onclick="filterProjects('ai', this)">🤖 AI &amp; Agentes</button>
      <button class="filter-btn" onclick="filterProjects('software', this)">💻 Software</button>
