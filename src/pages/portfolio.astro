    <!-- Grid de proyectos -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

      <!-- ─── 1 · Agente AI de Ventas — Javier Pereira Coffee ─── -->
      <article class="project-card glass card-hover p-6 flex flex-col gap-5" data-category="ai">

        <!-- IMAGEN: public/assets/portfolio/agente-cafe.jpg (descomenta cuando tengas el archivo) -->
        <!--
        <div class="rounded-xl overflow-hidden -mx-6 -mt-6 mb-1" style="aspect-ratio:16/9;">
          <img src="/assets/portfolio/agente-cafe.jpg" alt="Agente AI de ventas Javier Pereira Coffee" class="w-full h-full object-cover" loading="lazy">
        </div>
        -->

        <div class="flex items-start justify-between gap-3">
          <span class="badge badge-ai">AI &amp; Agentes</span>
          <span class="status" style="color:#bbc7c6">
            <span class="status-dot status-prod"></span>
            En producción
          </span>
        </div>

        <div class="w-12 h-12 rounded-xl flex items-center justify-center text-2xl icon-ai">☕</div>

        <div class="flex-1">
          <h2 class="text-lg font-semibold text-white mb-2">Agente AI de Ventas — Javier Pereira Coffee</h2>
