        <!-- IMAGEN: public/assets/portfolio/jesus-followeres.jpg -->
        <!--
        <div class="rounded-xl overflow-hidden -mx-6 -mt-6 mb-1" style="aspect-ratio:16/9;">
          <img src="/assets/portfolio/jesus-followeres.jpg" alt="Jesús Followeres app devocional infantil" class="w-full h-full object-cover" loading="lazy">
        </div>
        -->

